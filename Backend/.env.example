PORT=5000
DB_NAME=petcheckdb
DB_USER=postgres
# Must match docker-compose postgres password for local docker DB
DB_PASSWORD=Achirawit123
DB_HOST=127.0.0.1
DB_PORT=5432
# Dangerous with leftover lowercase "users" table — leave false unless needed
DB_SYNC_ALTER=false

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

REQUIRE_EMAIL_VERIFICATION=true
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
EMAIL_VERIFY_EXPIRES_HOURS=24
PASSWORD_RESET_EXPIRES_MINUTES=30

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# --- Real email (Gmail App Password recommended) ---
# 1) Enable 2-Step Verification on Google Account
# 2) Create App Password: https://myaccount.google.com/apppasswords
# 3) Fill values below (leave SMTP_SERVICE=gmail OR set SMTP_HOST=smtp.gmail.com)
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-app-password
EMAIL_FROM=CozyTail <your-gmail@gmail.com>

AVATAR_MAX_SIZE_BYTES=2097152
