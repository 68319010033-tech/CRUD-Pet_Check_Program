PORT=5000
DB_NAME=petcheckdb
DB_USER=postgres
# Must match docker-compose postgres password for local docker DB
DB_PASSWORD=Achirawit123
DB_HOST=127.0.0.1
DB_PORT=5432

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

REQUIRE_EMAIL_VERIFICATION=true
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
EMAIL_VERIFY_EXPIRES_HOURS=24
PASSWORD_RESET_EXPIRES_MINUTES=30

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
EMAIL_FROM=CozyTail <noreply@cozytail.local>

# Optional real SMTP (leave empty to use Ethereal/dev fallback)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

AVATAR_MAX_SIZE_BYTES=2097152
