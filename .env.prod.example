# On vps01: place this as /home/vps01/apps/s033-petcheck/.env
DOCKERHUB_USERNAME=your-dockerhub-username

DB_NAME=petcheckdb
DB_USER=postgres
DB_PASSWORD=change-me-strong-password

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# vps01 public ports (must be in 30100-30199, check docker ps first)
FRONTEND_PORT=30133
BACKEND_PORT=30134

FRONTEND_URL=http://202.29.231.188:30133
BACKEND_URL=http://202.29.231.188:30134

REQUIRE_EMAIL_VERIFICATION=true

EMAIL_FROM=CozyTail <noreply@cozytail.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
