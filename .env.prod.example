# Copy this file to the server as `.env` next to docker-compose.prod.yml
DOCKERHUB_USERNAME=achirawit1

DB_NAME=petcheckdb
DB_USER=postgres
DB_PASSWORD=change-me-strong-password

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

FRONTEND_PORT=80
BACKEND_PORT=5000

# Public URLs of this server (used in verification / reset emails)
FRONTEND_URL=http://YOUR_SERVER_IP
BACKEND_URL=http://YOUR_SERVER_IP:5000

REQUIRE_EMAIL_VERIFICATION=true

# Optional SMTP
EMAIL_FROM=CozyTail <noreply@cozytail.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
